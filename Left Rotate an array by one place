class Solution {
    public void rotateArrayByOne(int[] nums) {
        int temp=nums[0];
         if (nums.length <= 1) {
            return; // No rotation needed for empty or single-element array
        }
        for(int i=1;i<nums.length;i++){
            nums[i-1]=nums[i];
        }
        nums[nums.length-1]=temp;
        }
    }
