
class Solution {
    public List<Integer> intersection(int[] a, int[] b) {
        List<Integer> ans = new ArrayList<>();
        int i = 0, j = 0;
        int n1 = a.length, n2 = b.length;
        
        while (i < n1 && j < n2) {
            if (a[i] == b[j]) {
                ans.add(a[i]);
                i++;
                j++;
            } else if (a[i] < b[j]) {
                i++;
            } else {
                j++;
            }
        }
        
        return ans;
    }
}
